@{
    ViewBag.Title = "Home";
}

<!-- Satisfies: Using Sessions - displays personalized welcome if logged in -->
<section>
    <div class="hero">
        <div class="hero-text">
            <h2>@ViewBag.WelcomeMessage</h2>
            <p>Your destination for quality meals and convenient ordering</p>
        </div>
    </div>
</section>

<section>
    <h2 style="text-align: center;">Our Vision</h2>
    <article>
        <div class="card">
            <h3>Problem Statement</h3>
            <p>Students at KAU University often struggle with <strong>long queues</strong> during peak hours, making it difficult to find time for meals between classes. Additionally, there is limited <strong>menu visibility</strong>, causing uncertainty about available options and wait times.</p>
        </div>
        <div class="card">
            <h3>Project Solution</h3>
            <p>Our website provides <strong>real-time updates</strong> on menu availability and estimated wait times. Students can plan their visits better using our <strong>scheduling system</strong>, ensuring they get their meals without disrupting their academic schedules.</p>
        </div>
    </article>
</section>

<section>
    <h2>Why Choose KAU Restaurant?</h2>
    <div class="card">
        <h3>Student Benefits</h3>
        <ol>
            <li>Real-time queue updates</li>
            <li>Full menu visibility with nutritional information</li>
            <li>Online ordering with scheduled pickup times</li>
            <li>Student discounts on all meal plans</li>
            <li>Multiple payment options including university meal cards</li>
            <li>Vegetarian and special dietary options available</li>
        </ol>
    </div>
</section>
