@model KAU_Restaurant.Models.Student
@{
    ViewBag.Title = "Student Profile";
}

<!-- Satisfies: Using Sessions - Profile page, redirects to Login if Session empty -->
<!-- Satisfies: Update - Update Password form -->
<!-- Satisfies: Delete - Delete Account form -->

<div class="login-wrapper">
    <div class="login-form-container">
        <h2 style="color: #68705C;">Student Profile</h2>

        @if (Model != null)
        {
            <div class="card" style="text-align: left;">
                <h3>Account Details</h3>
                <p><strong>Student ID:</strong> @Model.StudentID</p>
                <p><strong>Full Name:</strong> @Model.FullName</p>
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Message))
            {
                <div style="color: green; font-weight: 600; margin-bottom: 15px;">@ViewBag.Message</div>
            }
            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div style="color: red; font-weight: 600; margin-bottom: 15px;">@ViewBag.Error</div>
            }

            <hr style="margin: 20px 0; border-color: #B7B7A4;" />

            <!-- Satisfies: Update - Update Password -->
            <h3>Update Password</h3>
            @using (Html.BeginForm("UpdatePassword", "Profile", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label for="newPassword">New Password</label>
                    <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password" required>
                </div>
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password" required>
                </div>
                <button type="submit" class="btn">Update Password</button>
            }

            <hr style="margin: 20px 0; border-color: #B7B7A4;" />

            <!-- Satisfies: Delete - Delete Account -->
            <h3 style="color: red;">Danger Zone</h3>
            <p style="font-size: 0.9em; margin-bottom: 15px;">Once you delete your account, there is no going back.</p>
            @using (Html.BeginForm("DeleteAccount", "Profile", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn" style="background-color: #cc3333;"
                        onclick="return confirm('Are you sure you want to permanently delete your account?');">
                    Delete My Account
                </button>
            }
        }
        else
        {
            <p>Student record not found.</p>
        }
    </div>
</div>
