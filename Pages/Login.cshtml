@page
@model Group9_CPIS_358_IS1_WEB.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    .auth-bg {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: linear-gradient(135deg, #f7f2ec 0%, #ffe8d6 60%, #e8ddd4 100%);
        position: relative;
        overflow: hidden;
    }

    .auth-bg::before {
        content: '';
        position: absolute;
        top: -100px; left: -100px;
        width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(203,153,126,0.18) 0%, transparent 70%);
        border-radius: 50%;
    }

    .auth-bg::after {
        content: '';
        position: absolute;
        bottom: -80px; right: -80px;
        width: 350px; height: 350px;
        background: radial-gradient(circle, rgba(104,112,92,0.13) 0%, transparent 70%);
        border-radius: 50%;
    }

    .auth-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 440px;
        background: rgba(255, 255, 255, 0.97);
        border-radius: 24px;
        box-shadow: 0 24px 80px rgba(63, 66, 56, 0.18), 0 4px 20px rgba(0,0,0,0.06);
        padding: 44px 40px;
        text-align: center;
        animation: cardIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        border: 1px solid rgba(255,255,255,0.8);
    }

    @@keyframes cardIn {
        from { opacity: 0; transform: translateY(28px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .auth-logo-ring {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        margin: 0 auto 20px;
        display: block;
        object-fit: cover;
        border: 3px solid #CB997E;
        box-shadow: 0 0 0 6px rgba(203,153,126,0.15), 0 8px 24px rgba(203,153,126,0.25);
        transition: transform 0.3s;
    }

    .auth-logo-ring:hover { transform: scale(1.05); }

    .auth-card h2 {
        font-family: 'Inter', sans-serif;
        font-size: 1.65rem;
        font-weight: 800;
        color: #3F4238;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }

    .auth-subtitle {
        color: #9a9183;
        font-size: 0.9rem;
        margin-bottom: 30px;
        font-family: 'Inter', sans-serif;
    }

    .db-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #a5d6a7;
        border-radius: 30px;
        padding: 6px 14px;
        font-size: 0.78rem;
        font-weight: 600;
        margin-bottom: 24px;
        font-family: 'Inter', sans-serif;
    }

    .db-dot {
        width: 7px; height: 7px;
        border-radius: 50%;
        background: #2e7d32;
    }

    .field-group {
        text-align: left;
        margin-bottom: 18px;
    }

    .field-group label {
        display: block;
        margin-bottom: 7px;
        font-weight: 600;
        font-size: 0.84rem;
        color: #5a5e52;
        letter-spacing: 0.2px;
        font-family: 'Inter', sans-serif;
    }

    .field-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }


    .field-group input {
        width: 100%;
        padding: 13px 16px;
        border: 1.5px solid #e4e0da;
        border-radius: 12px;
        font-size: 0.95rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.22s;
        background: #fafaf8;
        color: #3F4238;
        box-sizing: border-box;
        line-height: 1.4;
    }

    .field-group input:focus {
        border-color: #68705C;
        outline: none;
        box-shadow: 0 0 0 4px rgba(104,112,92,0.12);
        background: #fff;
    }

    .field-group input::placeholder { color: #c4bfb9; }

    .auth-error {
        background: #fff0f0;
        border: 1px solid #ffb3b3;
        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 14px;
        font-size: 0.84rem;
        color: #c62828;
        font-weight: 600;
        text-align: left;
        font-family: 'Inter', sans-serif;
    }

    .btn-auth {
        width: 100%;
        padding: 14px;
        background: linear-gradient(135deg, #CB997E 0%, #a07055 100%);
        color: white;
        border: none;
        border-radius: 13px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s;
        letter-spacing: 0.3px;
        font-family: 'Inter', sans-serif;
        box-shadow: 0 6px 20px rgba(203,153,126,0.4);
        margin-top: 4px;
    }

    .btn-auth:hover {
        background: linear-gradient(135deg, #b8836b, #68705C);
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(203,153,126,0.45);
    }

    .btn-auth:active { transform: translateY(0); }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 22px 0 18px;
        color: #c4bfb9;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
    }

    .auth-divider::before,
    .auth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #ece8e1;
    }

    .auth-footer-link {
        font-size: 0.87rem;
        color: #9a9183;
        font-family: 'Inter', sans-serif;
        margin-top: 4px;
    }

    .auth-footer-link a {
        color: #CB997E;
        font-weight: 700;
        text-decoration: none;
    }

    .auth-footer-link a:hover { text-decoration: underline; }

    .tip-box {
        background: linear-gradient(135deg, #f9f5f1, #fff8f2);
        border: 1px solid #ece0d4;
        border-radius: 12px;
        padding: 12px 16px;
        margin-top: 20px;
        font-size: 0.8rem;
        color: #9a9183;
        text-align: left;
        font-family: 'Inter', sans-serif;
        line-height: 1.5;
    }

    .tip-box strong { color: #68705C; }
    .tip-box a { color: #CB997E; font-weight: 600; }
</style>

<div class="auth-bg">
    <div class="auth-card">
        <img src="~/images/res-logo.png" alt="KAU Restaurant Logo" class="auth-logo-ring">
        <h2>Welcome back</h2>
        <p class="auth-subtitle">Sign in to manage your orders</p>

        <div class="db-badge">
            <span class="db-dot"></span>
            Database connected
        </div>

        @if (!ModelState.IsValid && ModelState.ErrorCount > 0)
        {
            <div class="auth-error">
                ⚠ @Html.ValidationSummary(true)
            </div>
        }

        <form id="login-form" method="post">
            <div class="field-group">
                <label asp-for="Input.StudentId">Student ID</label>
                <div class="field-wrap">
                    <input asp-for="Input.StudentId" type="text" placeholder="7-digit Student ID" required maxlength="7" autocomplete="username">
                </div>
            </div>
            <div class="field-group">
                <label asp-for="Input.Password">Password</label>
                <div class="field-wrap">
                    <input asp-for="Input.Password" type="password" placeholder="Enter your password" required autocomplete="current-password">
                </div>
            </div>
            <div asp-validation-summary="All" style="color:#c62828; font-size:0.84rem; margin-bottom:12px; text-align:left;"></div>
            <button type="submit" class="btn-auth" id="login-btn">Sign in →</button>
        </form>

        <div class="auth-divider">or</div>

        <p class="auth-footer-link">Don't have an account? <a href="/Signup">Create one here</a></p>

        <div class="tip-box">
            💡 <strong>First time?</strong> <a href="/Signup">Sign up first</a> — your account will be saved to the database right away.
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
