@using Microsoft.AspNetCore.Http.Features

@{
    var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    <style>
        #cookieBanner {
            position: fixed;
            bottom: 28px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 99999;
            width: min(720px, calc(100% - 40px));
            background: #ffffff;
            border-radius: 18px;
            box-shadow: 0 20px 60px rgba(63, 66, 56, 0.22), 0 4px 16px rgba(0,0,0,0.08);
            display: flex;
            align-items: center;
            gap: 20px;
            padding: 20px 24px;
            border: 1.5px solid #ece8e1;
            animation: slideUpCookie 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        @@keyframes slideUpCookie {
            from { opacity: 0; transform: translateX(-50%) translateY(40px); }
            to   { opacity: 1; transform: translateX(-50%) translateY(0); }
        }

        .cookie-icon-wrap {
            flex-shrink: 0;
            width: 54px;
            height: 54px;
            background: linear-gradient(135deg, #CB997E, #a0785a);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            box-shadow: 0 4px 12px rgba(203, 153, 126, 0.4);
        }

        .cookie-text-wrap {
            flex: 1;
        }

        .cookie-text-wrap h4 {
            margin: 0 0 4px 0;
            font-size: 0.97rem;
            font-weight: 700;
            color: #3F4238;
            font-family: 'Inter', 'Segoe UI', sans-serif;
        }

        .cookie-text-wrap p {
            margin: 0;
            font-size: 0.82rem;
            color: #888;
            font-family: 'Inter', 'Segoe UI', sans-serif;
            line-height: 1.5;
        }

        .cookie-text-wrap p a {
            color: #CB997E;
            font-weight: 600;
            text-decoration: none;
        }

        .cookie-text-wrap p a:hover { text-decoration: underline; }

        .cookie-btn-wrap {
            display: flex;
            gap: 10px;
            flex-shrink: 0;
        }

        .btn-cookie-accept {
            padding: 10px 22px;
            border: none;
            border-radius: 10px;
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #68705C, #4a5040);
            color: #ffffff;
            transition: transform 0.15s, box-shadow 0.2s;
            box-shadow: 0 4px 12px rgba(104, 112, 92, 0.35);
        }

        .btn-cookie-accept:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(104, 112, 92, 0.45);
        }

        .btn-cookie-reject {
            padding: 10px 22px;
            border: 1.5px solid #ddd;
            border-radius: 10px;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            font-family: 'Inter', 'Segoe UI', sans-serif;
            background: transparent;
            color: #888;
            transition: border-color 0.2s, color 0.2s, transform 0.15s;
        }

        .btn-cookie-reject:hover {
            border-color: #c62828;
            color: #c62828;
            transform: translateY(-2px);
        }

        @@media (max-width: 580px) {
            #cookieBanner {
                flex-direction: column;
                text-align: center;
                padding: 20px 18px;
                bottom: 12px;
            }
            .cookie-btn-wrap { width: 100%; justify-content: center; }
        }
    </style>

    <div id="cookieBanner" role="dialog" aria-label="Cookie consent">
        <div class="cookie-icon-wrap">🍪</div>
        <div class="cookie-text-wrap">
            <h4>We use cookies</h4>
            <p>We use cookies to enhance your experience. By continuing, you agree to our use of cookies. <a asp-page="/Privacy">Learn more</a>.</p>
        </div>
        <div class="cookie-btn-wrap">
            <button class="btn-cookie-accept" id="cookieAccept" data-cookie-string="@cookieString">✓ Accept</button>
            <button class="btn-cookie-reject" id="cookieReject">✕ Reject</button>
        </div>
    </div>

    <script>
        (function () {
            var banner = document.getElementById('cookieBanner');
            document.getElementById('cookieAccept').addEventListener('click', function () {
                document.cookie = this.dataset.cookieString;
                banner.style.animation = 'none';
                banner.style.opacity = '0';
                banner.style.transform = 'translateX(-50%) translateY(40px)';
                banner.style.transition = 'opacity 0.3s, transform 0.3s';
                setTimeout(function () { banner.remove(); }, 350);
            });
            document.getElementById('cookieReject').addEventListener('click', function () {
                banner.style.animation = 'none';
                banner.style.opacity = '0';
                banner.style.transform = 'translateX(-50%) translateY(40px)';
                banner.style.transition = 'opacity 0.3s, transform 0.3s';
                setTimeout(function () { banner.remove(); }, 350);
            });
        })();
    </script>
}
