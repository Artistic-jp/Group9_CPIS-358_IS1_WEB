@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name;
    <div class="icon-item">
        <img src="~/images/user.png" alt="User" />
        <span style="color:#FFE8D6;font-weight:600;">@displayName</span>
        <form class="form-inline d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" style="display:inline;">
            <button type="submit" style="background:none; border:none; color:#CB997E; font-size:0.8em; padding-left: 5px; cursor: pointer;">(Logout)</button>
        </form>
    </div>
}
else
{
    <div class="icon-item" style="margin-right: 10px;">
        <img src="~/images/user.png" alt="User" />
        <span><a href="/Signup" style="font-weight: 700;">Sign up</a></span>
    </div>
    <div class="icon-item">
        <span><a href="/Login" style="font-weight: 700;">Log in</a></span>
    </div>
}
