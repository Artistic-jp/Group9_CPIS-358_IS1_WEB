@page
@model Group9_CPIS_358_IS1_WEB.Pages.SignupModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* ── Background: clean neutral, consistent with the rest of the site ── */
    .auth-bg {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: #f5f3f0;   /* neutral off-white/beige — no green gradient */
    }

    .auth-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 460px;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 24px 80px rgba(63, 66, 56, 0.13), 0 4px 20px rgba(0,0,0,0.05);
        padding: 44px 40px;
        text-align: center;
        animation: cardIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        border: 1.5px solid #ece9e4;
    }

    @@keyframes cardIn {
        from { opacity: 0; transform: translateY(28px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ── Avatar icon box — warm terracotta to match login accent ── */
    .auth-avatar {
        width: 72px;
        height: 72px;
        background: linear-gradient(135deg, #CB997E 0%, #a07055 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        box-shadow: 0 8px 24px rgba(203,153,126,0.45), 0 2px 6px rgba(0,0,0,0.10);
    }

    .auth-avatar svg {
        width: 42px;
        height: 42px;
        display: block;
    }

    .auth-card h2 {
        font-family: 'Inter', sans-serif;
        font-size: 1.65rem;
        font-weight: 800;
        color: #3F4238;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }

    .auth-subtitle {
        color: #9a9183;
        font-size: 0.9rem;
        margin-bottom: 30px;
        font-family: 'Inter', sans-serif;
    }

    .progress-steps {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 28px;
    }

    .step-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ece8e1;
        transition: all 0.3s;
    }

    .step-dot.active {
        background: #CB997E;
        width: 24px;
        border-radius: 4px;
    }

    .field-group {
        text-align: left;
        margin-bottom: 18px;
    }

    .field-group label {
        display: block;
        margin-bottom: 7px;
        font-weight: 600;
        font-size: 0.84rem;
        color: #5a5e52;
        letter-spacing: 0.2px;
        font-family: 'Inter', sans-serif;
    }

    .field-wrap {
        position: relative;
        display: flex;
        align-items: center;
    }

    .field-group input {
        width: 100%;
        padding: 13px 16px;
        border: 1.5px solid #e4e0da;
        border-radius: 12px;
        font-size: 0.95rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.22s;
        background: #fafaf8;
        color: #3F4238;
        box-sizing: border-box;
        line-height: 1.4;
    }

    .field-group input:focus {
        border-color: #CB997E;
        outline: none;
        box-shadow: 0 0 0 4px rgba(203,153,126,0.14);
        background: #fff;
    }

    .field-group input::placeholder { color: #c4bfb9; }

    .field-hint {
        font-size: 0.75rem;
        color: #b0ab9f;
        margin-top: 5px;
        font-family: 'Inter', sans-serif;
        padding-left: 4px;
    }

    .auth-error {
        background: #fff0f0;
        border: 1px solid #ffb3b3;
        border-radius: 10px;
        padding: 10px 14px;
        margin-bottom: 14px;
        font-size: 0.84rem;
        color: #c62828;
        font-weight: 600;
        text-align: left;
        font-family: 'Inter', sans-serif;
    }

    /* ── Button: warm terracotta, identical to Login ── */
    .btn-auth {
        width: 100%;
        padding: 14px;
        background: linear-gradient(135deg, #CB997E 0%, #a07055 100%);
        color: white;
        border: none;
        border-radius: 13px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.25s;
        letter-spacing: 0.3px;
        font-family: 'Inter', sans-serif;
        box-shadow: 0 6px 20px rgba(203,153,126,0.40);
        margin-top: 4px;
    }

    .btn-auth:hover {
        background: linear-gradient(135deg, #b8836b, #68705C);
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(203,153,126,0.45);
    }

    .btn-auth:active { transform: translateY(0); }

    .requirements-box {
        background: #fff8f2;
        border: 1px solid #ece0d4;
        border-radius: 10px;
        padding: 10px 14px;
        margin-top: 6px;
        font-size: 0.76rem;
        color: #9a8070;
        text-align: left;
        font-family: 'Inter', sans-serif;
    }

    .auth-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 22px 0 18px;
        color: #c4bfb9;
        font-size: 0.8rem;
        font-family: 'Inter', sans-serif;
    }

    .auth-divider::before,
    .auth-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: #ece8e1;
    }

    .auth-footer-link {
        font-size: 0.87rem;
        color: #9a9183;
        font-family: 'Inter', sans-serif;
        margin-top: 4px;
    }

    .auth-footer-link a {
        color: #CB997E;
        font-weight: 700;
        text-decoration: none;
    }

    .auth-footer-link a:hover { text-decoration: underline; }
</style>

<div class="auth-bg">
    <div class="auth-card">

        <div class="auth-avatar">
            <svg viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <line x1="8" y1="21" x2="18" y2="21" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                <line x1="13" y1="16" x2="13" y2="26" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                <circle cx="30" cy="15" r="6" stroke="white" stroke-width="2.2"/>
                <path d="M20 37c0-5.52 4.48-10 10-10s10 4.48 10 10" stroke="white" stroke-width="2.2" stroke-linecap="round"/>
            </svg>
        </div>

        <h2>Create account</h2>
        <p class="auth-subtitle">Join KAU Restaurant — it only takes a minute</p>

        <div class="progress-steps">
            <div class="step-dot active"></div>
            <div class="step-dot"></div>
            <div class="step-dot"></div>
        </div>

        @if (!ModelState.IsValid && ModelState.ErrorCount > 0)
        {
            <div class="auth-error">⚠ Please fix the errors below.</div>
        }

        <form id="signup-form" method="post">

            <div class="field-group">
                <label asp-for="Input.StudentId">Student ID</label>
                <div class="field-wrap">
                    <input asp-for="Input.StudentId" type="text" required maxlength="7" placeholder="e.g. 1234567" pattern="[0-9]{7}" inputmode="numeric">
                </div>
                <div class="field-hint">Must be exactly 7 digits</div>
                <span asp-validation-for="Input.StudentId" style="color:#c62828; font-size:0.8rem;"></span>
            </div>

            <div class="field-group">
                <label asp-for="Input.FullName">Full Name</label>
                <div class="field-wrap">
                    <input asp-for="Input.FullName" type="text" required placeholder="Your full name">
                </div>
                <span asp-validation-for="Input.FullName" style="color:#c62828; font-size:0.8rem;"></span>
            </div>

            <div class="field-group">
                <label asp-for="Input.Password">Password</label>
                <div class="field-wrap">
                    <input asp-for="Input.Password" type="password" required placeholder="Create a strong password">
                </div>
                <div class="requirements-box">
                    Minimum 6 characters · At least one uppercase · At least one digit
                </div>
                <span asp-validation-for="Input.Password" style="color:#c62828; font-size:0.8rem;"></span>
            </div>

            <div asp-validation-summary="All" style="color:#c62828; font-size:0.84rem; margin-bottom:12px; text-align:left;"></div>
            <button type="submit" class="btn-auth" id="signup-btn">Create account →</button>
        </form>

        <div class="auth-divider">or</div>

        <p class="auth-footer-link">Already have an account? <a href="/Login">Sign in here</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var inputs = document.querySelectorAll('.field-group input');
        var dots = document.querySelectorAll('.step-dot');
        inputs.forEach(function(input, i) {
            input.addEventListener('focus', function() {
                dots.forEach(function(d) { d.classList.remove('active'); });
                if (dots[i]) dots[i].classList.add('active');
            });
        });
    </script>
}
